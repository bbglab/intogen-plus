Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.7.19-python3.10-bookworm

%environment
    export UV_COMPILE_BYTECODE=1

%setup
    # Stage necessary files
    mkdir -p ${SINGULARITY_ROOTFS}/hotmaps
    cp -r uv.lock ${SINGULARITY_ROOTFS}/hotmaps/uv.lock
    cp -r pyproject.toml ${SINGULARITY_ROOTFS}/hotmaps/pyproject.toml
    cp -r hotmaps.sh ${SINGULARITY_ROOTFS}/hotmaps/hotmaps.sh
    cp -r scripts/ ${SINGULARITY_ROOTFS}/hotmaps/scripts/
    cp README.md ${SINGULARITY_ROOTFS}/hotmaps/
    cp MANIFEST.in ${SINGULARITY_ROOTFS}/hotmaps/

%post
    # Install dependencies and build
    mkdir -p /root/.cache/uv
    cd /hotmaps
    uv sync --frozen --no-dev

%environment
    PATH="/hotmaps/.venv/bin:$PATH"

%runscript
    exec "/bin/sh" "/hotmaps/hotmaps.sh" "$@"

%labels
    Author "BBGLab <bbglab@irbarcelona.org>"
    Maintainer "Federica Brando <federica.brandoe@irbbarcelona.org>"
    Version "1.0.0"
    Description "HotMAPS panel for IntOGen"